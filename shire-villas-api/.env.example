# REQUIRED FOR PRODUCTION
ENV=production
TEAM_API_KEY=replace-with-long-random-secret
SECRET_KEY=replace-with-long-random-secret
DATABASE_URL=${{Postgres.DATABASE_URL}}

# AI + SEARCH
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
APOLLO_API_KEY=

# BUSINESS POLICY - CHANGE THESE, NOT CODE
SHIRE_MIN_BUDGET_CR=10
SHIRE_QUALIFIED_SCORE=70
SHIRE_PRIORITY_SCORE=90
SHIRE_TARGET_LOCATIONS=Siolim,Assagao,Vagator,Morjim,Anjuna,North Goa

# BOT CONTROL
LEAD_BOT_PROVIDER=auto
LEAD_BOT_MIN_SCORE=70
LEAD_BOT_MAX_RESULTS_PER_QUERY=8
LEAD_BOT_TIME_RANGE=year
LEAD_BOT_REQUIRE_IDENTIFIABLE_BUYER=true
LEAD_BOT_ACTIONABLE_SCORE=70
LEAD_BOT_MIN_ADMISSION_SCORE=50
AUTO_PROMOTE_QUALIFIED_LEADS=false

# CRM
FLOWCONNECT_WEBHOOK_URL=
FLOWCONNECT_API_KEY=
FLOWCONNECT_WEBHOOK_SECRET=

# MEDIA
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OPTIONAL
CORS_ORIGINS=http://localhost:8000
HTTP_TIMEOUT_SECONDS=30
DAILY_SUITE_LOCK_MINUTES=45

# V7.1 FINAL EXECUTION
STORE_IDENTIFIED_SIGNALS_WITHOUT_CONTACT=true
ENRICHMENT_RETRY_LIMIT=50
FINAL_SUITE_AUTO_PROMOTE=false
